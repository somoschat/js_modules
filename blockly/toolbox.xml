<xml xmlns="https://developers.google.com/blockly/xml" id="toolbox" style="display: none">
    
    <!-- 1. Interação (Verde Escuro) -->
    <category name="Interação" colour="160">
      <block type="sc_msg">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT">Olá, mundo!</field>
          </shadow>
        </value>
      </block>      
      <block type="sc_linebreak"></block>
      <block type="sc_msg_br"></block>
      <block type="text_join">
        <value name="ADD0">
          <shadow type="text">
            <field name="TEXT">Texto</field>
          </shadow>
        </value>
        <value name="ADD1">
          <shadow type="sc_session_var">
            <field name="VAR_NAME">variavel</field>
          </shadow>
        </value>
      </block>
      <block type="sc_val_text_var">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT">Texto</field>
          </shadow>
        </value>
        <value name="VAR">
          <shadow type="sc_session_var">
            <field name="VAR_NAME">variavel</field>
          </shadow>
        </value>
      </block>
      <block type="sc_val_loc">
        <value name="DESC">
          <shadow type="text">
            <field name="TEXT">Local</field>
          </shadow>
        </value>
        <value name="LAT">
          <shadow type="math_number">
            <field name="NUM">-10.0</field>
          </shadow>
        </value>
        <value name="LONG">
          <shadow type="math_number">
            <field name="NUM">-50.0</field>
          </shadow>
        </value>
      </block>
      <block type="sc_opc">
        <value name="EXTRA_OP">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
    </category>

    <!-- 2. Fluxo (Roxo) -->
    <category name="Fluxo" colour="290">
    <block type="sc_out">
        <value name="MSG">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
        <value name="ACTION">
          <shadow type="sc_sys_action"></shadow>
        </value>
      </block>
      <block type="sc_se">
        <value name="COND">
          <shadow type="sc_cond">
            <value name="A">              
            </value>
            <value name="B">
              <shadow type="text">
                <field name="TEXT"></field>
              </shadow>
            </value>
          </shadow>
        </value>
      </block>
      <block type="sc_cond_logic"></block>
      <block type="sc_cond_group"></block>
      <block type="sc_cond">
        <value name="A">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
        <value name="B">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
      <block type="sc_sleep">
        <value name="SECONDS">
          <shadow type="math_number">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
      
      <block type="sc_ign">
        <value name="VAL0">
          <shadow type="text">
            <field name="TEXT">#ignoradefault</field>
          </shadow>
        </value>
        <value name="VAL1">
          <shadow type="text">
            <field name="TEXT">#ignoradefault</field>
          </shadow>
        </value>
      </block>
      <block type="sc_lmt"></block>
      <block type="sc_lmt_retorno"></block>
      <block type="sc_sys_action"></block>
      <block type="sc_sys_scene"></block>
      <block type="sc_sys_human"></block>
    </category>

    <!-- 3. Memória (Rosa/Roxo Claro - Nova Cor) -->
    <category name="Memória" colour="330">
      <block type="sc_session_var">
        <field name="VAR_NAME">nome</field>
      </block>
      <block type="sc_mem">
        <value name="KEY">
          <shadow type="text">
            <field name="TEXT">nome variavel</field>
          </shadow>
        </value>
        <value name="VALUE">
          <shadow type="text">
            <field name="TEXT">valor</field>
          </shadow>
        </value>
      </block>
      <block type="sc_var">
        <value name="KEY">
          <shadow type="text">
            <field name="TEXT">nome variavel</field>
          </shadow>
        </value>
        <value name="VALUE">
          <shadow type="text">
            <field name="TEXT">valor</field>
          </shadow>
        </value>
      </block>
      <block type="sc_clm"></block>
      <block type="sc_system_var">
        <field name="VAR_NAME">id</field>
      </block>
      <block type="sc_mem_unescape">
        <field name="VAR_NAME">variavel</field>
      </block>
      <block type="sc_mem_numeric">
        <field name="VAR_NAME">variavel</field>
      </block>
      <block type="sc_mem_money">
        <field name="VAR_NAME">variavel</field>
      </block>
      <block type="sc_mem_position">
        <field name="VAR_NAME">variavel</field>
        <field name="PARAM">0</field>
      </block>
      <block type="sc_mem_date">
        <field name="VAR_NAME">variavel</field>
        <field name="FORMAT">data</field>
      </block>
      <block type="sc_mem_json">
        <field name="VAR_NAME">variavel</field>
        <field name="PROP">propriedade</field>
        <field name="SUBPROP"></field>
      </block>
      <block type="sc_sys_vsys"></block>
      <block type="sc_sys_vmem"></block>
    </category>

    <!-- 4. Usuário (Marrom/Cobre) -->
    <category name="Usuário" colour="65">
      <block type="sc_reg">
        <value name="KEY1">
          <shadow type="text">
            <field name="TEXT">Ref</field>
          </shadow>
        </value>
        <value name="KEY2">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
      <block type="sc_lgn">
        <value name="KEY1">
          <shadow type="text">
            <field name="TEXT">Ref</field>
          </shadow>
        </value>
        <value name="KEY2">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
      <block type="sc_lgf">
        <value name="KEY1">
          <shadow type="text">
            <field name="TEXT">Ref</field>
          </shadow>
        </value>
        <value name="KEY2">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
      <block type="sc_set">
        <value name="VALUE">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
      <block type="sc_set_retorno"></block>
      <block type="sc_get">
        <value name="VAR">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
      <block type="sc_ban">
        <value name="TRIES">
          <shadow type="math_number">
            <field name="NUM">3</field>
          </shadow>
        </value>
        <value name="TIME">
          <shadow type="math_number">
            <field name="NUM">60</field>
          </shadow>
        </value>
        <value name="ACTION">
          <shadow type="sc_sys_action">
            <field name="ACTION">{end}</field>
          </shadow>
        </value>
      </block>
      <block type="sc_reg_erro"></block>
      <block type="sc_reg_var"></block>
      <block type="sc_urg">
         <value name="KEY1">
          <shadow type="text">
            <field name="TEXT">Ref</field>
          </shadow>
        </value>
        <value name="KEY2">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
    </category>

    <!-- 5. Dados (Laranja/Cobre - Nova Categoria) -->
    <category name="Dados" colour="20">
      <block type="sc_tab">
        <value name="ID">
          <shadow type="text">
            <field name="TEXT">123</field>
          </shadow>
        </value>
        <value name="URL">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
      </block>
      <block type="sc_tab_retorno"></block>
      <block type="sc_gtb">
        <value name="ID">
          <shadow type="text">
            <field name="TEXT">123</field>
          </shadow>
        </value>
        <value name="VAR">
          <shadow type="text">
            <field name="TEXT">dados</field>
          </shadow>
        </value>
      </block>
      <block type="sc_frm"></block>
      <block type="sc_frm_guid"></block>
      <block type="sc_frm_url"></block>
    </category>

    <!-- 6. Integrações (Verde Claro) -->
    <category name="Integrações" colour="120">
      <block type="sc_api">
        <value name="URL">
          <shadow type="text">
            <field name="TEXT">https://api.exemplo.com</field>
          </shadow>
        </value>
      </block>
      <block type="sc_api_auth">
        <value name="VALUE">
          <shadow type="text">
            <field name="TEXT">Basic [token]</field>
          </shadow>
        </value>
      </block>
      <block type="sc_api_status"></block>
      <block type="sc_api_result"></block>
      <block type="sc_whk">
        <value name="URL">
          <shadow type="text">
            <field name="TEXT">https://webhook.site/...</field>
          </shadow>
        </value>
      </block>
      <block type="sc_pdf">
        <value name="MEM">
          <shadow type="text">
            <field name="TEXT">variavel_pdf</field>
          </shadow>
        </value>
        <value name="NAME">
          <shadow type="text">
            <field name="TEXT">nome_do_arquivo.pdf</field>
          </shadow>
        </value>
        <value name="SOURCE">
          <shadow type="text">
            <field name="TEXT">html ou url</field>
          </shadow>
        </value>
      </block>
      <block type="sc_gbn">
        <value name="URL">
          <shadow type="text">
            <field name="TEXT">https://url.com/file.pdf</field>
          </shadow>
        </value>
        <value name="MEM">
          <shadow type="text">
            <field name="TEXT">arquivo</field>
          </shadow>
        </value>
      </block>
    </category>

    <!-- 7. Matemática (Azul) -->
    <category name="Matemática" colour="230">
      <block type="math_number"></block>
      <block type="math_arithmetic"></block>
      <block type="sc_mth">
        <value name="FORMULA">
          <shadow type="math_arithmetic">
            <value name="A">
              <shadow type="math_number">
                <field name="NUM">1</field>
              </shadow>
            </value>
            <value name="B">
              <shadow type="math_number">
                <field name="NUM">1</field>
              </shadow>
            </value>
          </shadow>
        </value>
      </block>
      <block type="sc_mthretorno"></block>
      <block type="sc_math_group">
        <value name="NUM">
          <shadow type="math_number">
            <field name="NUM">1</field>
          </shadow>
        </value>
      </block>
    </category>

    <!-- 8. Texto (Marrom) -->
    <category name="Texto" colour="20">
      <block type="text"></block>
      <block type="sc_len">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT">Texto Exemplo</field>
          </shadow>
        </value>
      </block>
      <block type="sc_esq">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
        <value name="NUM">
          <shadow type="math_number">
            <field name="NUM">3</field>
          </shadow>
        </value>
      </block>
      <block type="sc_dir">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
        <value name="NUM">
          <shadow type="math_number">
            <field name="NUM">3</field>
          </shadow>
        </value>
      </block>
      <block type="sc_sbt">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT">Texto</field>
          </shadow>
        </value>
        <value name="INI">
          <shadow type="math_number">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="NUM">
          <shadow type="math_number">
            <field name="NUM">3</field>
          </shadow>
        </value>
      </block>
      <block type="sc_rpl">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT">Texto Antigo</field>
          </shadow>
        </value>
        <value name="FROM">
          <shadow type="text">
            <field name="TEXT">Antigo</field>
          </shadow>
        </value>
        <value name="TO">
          <shadow type="text">
            <field name="TEXT">Novo</field>
          </shadow>
        </value>
      </block>
      <block type="sc_txt_result"></block>
    </category>

    <!-- 9. Templates (Cinza) -->
    <category name="Templates" colour="180">
      <block type="sc_sys_msg"></block>
      <block type="sc_sys_arq"></block>
      <block type="sc_sys_img"></block>
      <block type="sc_sys_aud"></block>
      <block type="sc_sys_gim"></block>
      <block type="sc_sys_gaq"></block>
      <block type="sc_sys_vcd"></block>
    </category>

  </xml>
